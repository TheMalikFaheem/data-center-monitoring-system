# monitoring-watchdog.timer — fires the monitoring watchdog health check
# every 5 minutes. Persistent=true means a missed fire (e.g. during reboot)
# runs immediately on next boot, preventing silent monitoring gaps.
#
# Manage:
#   systemctl status monitoring-watchdog.timer
#   systemctl list-timers monitoring-watchdog.timer
#   journalctl -u monitoring-watchdog

[Unit]
Description=Run monitoring stack watchdog every 5 minutes
Documentation=file:///opt/monitoring/docs/runbook.md

[Timer]
# Fire 2 minutes after boot (give services time to start).
OnBootSec=2min
# Then fire every 5 minutes.
OnUnitActiveSec=5min
# If a fire was missed (system was down), fire immediately on next activation.
Persistent=true
# The service unit to activate.
Unit=monitoring-watchdog.service

[Install]
WantedBy=timers.target
