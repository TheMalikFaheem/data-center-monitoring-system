# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#     nano .env
#
# The .env file is git-ignored — it never leaves this server.

# Password for logging into Grafana as "admin". Change it.
GRAFANA_ADMIN_PASSWORD=changeme

# Your timezone, so graph timestamps and alert times match your clock.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Asia/Karachi
